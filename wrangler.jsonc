{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "word-adventure",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": ".cloudflare/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "word-adventure",
      // Deploy to Cloudflare replaces this template ID when provisioning D1.
      // Manual Git integration must supply the ID of its existing D1 database.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "observability": { "enabled": true }
}
